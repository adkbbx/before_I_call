# Copy to .env.local (gitignored). Never commit keys.

# Local open-weight model through Ollama (used by `npm run live` and `--provider ollama`)
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL=gemma4:e2b-it-qat

# Hosted open-weight model on DigitalOcean serverless inference (OpenAI-compatible)
HOSTED_BASE_URL=https://inference.do-ai.run/v1
HOSTED_MODEL=gemma-4-31B-it
GRADIENT_MODEL_ACCESS_KEY=

# Live API port for the local "retell again" control
LIVE_PORT=8790
