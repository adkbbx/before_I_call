{
  "name": "aoandon",
  "private": true,
  "version": "0.1.0",
  "description": "A hyakumonogatari night for Japanese learners: real kaidan retold at your JLPT level by an open-weight model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "live": "node server/live.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "fetch:aozora": "node pipeline/aozora.mjs",
    "fetch:jlpt": "node pipeline/jlpt.mjs --download",
    "retell": "node pipeline/retell.mjs",
    "build:tales": "node pipeline/build-tales.mjs",
    "report": "node pipeline/report.mjs",
    "assets:process": "node scripts/process-assets.mjs"
  },
  "dependencies": {
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/yuji-syuku": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "adm-zip": "^0.6.1",
    "iconv-lite": "^0.7.3",
    "kuromoji": "^0.1.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.5"
  }
}
