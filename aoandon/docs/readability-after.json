    "hits": [
      {
        "scene": "s01",
        "marker": "らず、ず",
        "sentence": "彼らは遠回りをしてでも、この場所を通らずに歩いたものである。"
      },
      {
        "scene": "s02",
        "marker": "べき",
        "sentence": "ここは若い女性が居るべき場所ではないと、商人は再び切に訴えて彼女を諭した。"
      },
      {
        "scene": "s04",
        "marker": "ぬ",
        "sentence": "男は濠の縁に立つ女を見た事、その女が何かを見せた事を語ったが、内容は言えぬとした。"
      }
    ],
    "names": [
      "ちん"
