    "scenes": 9
  },
  {
    "tale": "rokurokubi",
    "level": "N2",
    "coverage": 0.8643983513462845,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.2390761548064919,
    "meanLength": 34.08510638297872,
    "maxLength": 58,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s02",
        "marker": "わず、せず、ず",
        "sentence": "昔と同様に今は苦難をいとわず、天候やきせつにとんじゃくせず、他のそうりょたちがあえて行こうとしない場所へ足を運んだ。"
      },
      {
        "scene": "s04",
        "marker": "申し",
        "sentence": "男の親切な様子が気に入ったため、囘龍はその申し出を受けた。"
      },
      {
        "scene": "s11",
        "marker": "らず、ず",
        "sentence": "囘龍がはげしくなぐったにもかかわらず、首はそでからはなれなかった。"
      },
      {
        "scene": "s12",
        "marker": "ず",
        "sentence": "囘龍は問いに答えずほほえむばかりで、何も言わなかった。"
      },
      {
        "scene": "s13",
        "marker": "ず",
        "sentence": "にもかかわらず役人は、彼がじぶんたちをぶじょくしたと考えた。"
      },
      {
        "scene": "s13",
        "marker": "べき",
        "sentence": "だが一人の老人だけは反対し、首をよく調べるべきだと言った。"
      },
      {
        "scene": "s16",
        "marker": "申し",
        "sentence": "しかしその首で人を怖がらせたいと考え、それを買いたいと申し出た。"
      }
    ],
    "names": [
      "せいこう",
      "たき",
      "森",
      "さん"
    ],
    "scenes": 17
  },
  {
    "tale": "hoichi",
    "level": "N2",
    "coverage": 0.8567106973949555,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.26648637403786146,
    "meanLength": 35.60740740740741,
    "maxLength": 52,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s01",
        "marker": "らず、ず",
        "sentence": "武者のたましいとされる平家かにのみならず、この海岸一帯では多くの不思議な出来事が見聞きされる。"
      },
      {
        "scene": "s03",
        "marker": "申し、べき",
        "sentence": "和尚は芳一のおどろくべき技に感心して、寺をじぶんの家にしてもよいと申し出た。"
      },
      {
        "scene": "s06",
        "marker": "かず、ず",
        "sentence": "当時のさむらいの命令にしたがわないわけにはいかず、芳一は琵琶を持って外へ出た。"
      },
      {
        "scene": "s06",
        "marker": "らず、ず",
        "sentence": "大きな門に着いたが、近所にそんな門があるとは知らなかったにもかかわらず、中へ入った。"
      },
      {
        "scene": "s11",
        "marker": "わず、ず",
        "sentence": "目が見えないのにだれにも言わずに出かけるのは、危険に違いないと考えた。"
      },
      {
        "scene": "s12",
        "marker": "らず、ず",
        "sentence": "道が悪かったにもかかわらず、目が見えない芳一が速く歩いたに違いない。"
      },
      {
        "scene": "s13",
        "marker": "らず、わず、ず",
        "sentence": "状況が不気味であるにもかかわらず、しもべ達は笑わずにはいられなかった。"
      },
      {
        "scene": "s13",
        "marker": "べき",
        "sentence": "その後、和尚は芳一に、このおどろくべきこういの理由をくわしく説明させた。"
      },
      {
        "scene": "s16",
        "marker": "かず、ず",
        "sentence": "強い声で3回も名前を呼ばれたが、芳一は石のように動かず、息をこらえていた。"
      },
      {
        "scene": "s17",
        "marker": "ず",
        "sentence": "痛みは非常なものの、彼は声を上げず、足音が遠くなるのを待った。"
      }
    ],
    "names": [
