    "hits": [
      {
        "scene": "s02",
        "marker": "らず、ず",
        "sentence": "關内はとうわくしたにもかかわらず、茶を捨てて茶碗を見た。"
      },
      {
        "scene": "s03",
        "marker": "ず",
        "sentence": "ある日の夕方、關内がやしきで当番をしていた際、見知らぬ人が音も立てずに入ってきたためおどろいた。"
      }
    ],
    "names": [],
    "scenes": 5
  },
  {
    "tale": "yukionna",
    "level": "N2",
    "coverage": 0.8931743086181414,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.27257999189955445,
    "meanLength": 33.36486486486486,
    "maxLength": 50,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s02",
        "marker": "らず、ず",
        "sentence": "寒さにもかかわらず、とうとう彼もまたねむりに落ちた。"
      },
      {
        "scene": "s03",
        "marker": "わず、ず",
        "sentence": "彼女は彼を殺そうかと思ったが、若いので気の毒だと思わずにはいられない。"
      },
      {
        "scene": "s04",
        "marker": "ず",
        "sentence": "女のすがたはどこにも見えず、吹雪がはげしく小屋の中へ吹き込んでいるばかりか、風が強かった。"
      },
      {
        "scene": "s08",
        "marker": "わず、ず",
        "sentence": "彼はにこにこしながら、じぶんの上にかがんだ白い女のことばかりか、老人が何も言わずに死んだ事も話した。"
      }
    ],
    "names": [
