    "scenes": 4
  },
  {
    "tale": "chawan",
    "level": "N1",
    "coverage": 0.8758188739716743,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.3025936599423631,
    "meanLength": 42.06060606060606,
    "maxLength": 56,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s01",
        "marker": "ぬ",
        "sentence": "なぜけつまつをつけぬまま物語が途切れているのかはだれにもわからないため、一つの話を代表として選ぶことにした。"
      },
      {
        "scene": "s04",
        "marker": "ず",
        "sentence": "「見覚えはない」と關内は怒りつつ冷ややかに答えたが、客がどうしてこの邸へ入ったのかを尋ねずにはいられない。"
      },
      {
        "scene": "s04",
        "marker": "ず",
        "sentence": "關内は帯の短刀で男ののどを激しくついたが、全く手応えがなく、相手は音も立てず壁へ飛んで消えた。"
      },
      {
        "scene": "s04",
        "marker": "さず、ず",
        "sentence": "壁に跡すら残さず、まるで光が紙を通るように通り過ぎたその姿に、關内はぼうぜんとするしかなかった。"
      },
      {
        "scene": "s05",
        "marker": "ぬ",
        "sentence": "「傷が重いためとうじに行かねばならぬが、来月16日には必ず戻るはずだ」と続いた。"
      },
      {
        "scene": "s05",
        "marker": "致す",
        "sentence": "魂を飲んだ後の結果については、読み手の想像に任せることに致すのである。"
      }
    ],
    "names": [
      "平内",
      "殿"
    ],
    "scenes": 5
  },
  {
    "tale": "yukionna",
    "level": "N1",
    "coverage": 0.9042728269352368,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.3190070396443127,
    "meanLength": 38.55714285714286,
    "maxLength": 123,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s02",
        "marker": "べき",
        "sentence": "小屋には火鉢も火をたくべき場所もなく、窓のない一方口の二畳敷きという極めて狭い造りであった。"
      },
      {
        "scene": "s02",
        "marker": "ず",
        "sentence": "初めのうちは寒さを感じず、嵐もすぐに止むだろうと考えていた。"
      },
      {
        "scene": "s02",
        "marker": "れず、ず",
        "sentence": "しかし、とうとう極限の寒さを堪えきれず、彼もまた深い眠りに就いたのであった。"
      },
      {
        "scene": "s03",
        "marker": "わず、ず",
        "sentence": "しかし、あなたは若いので気の毒だと思わずにはいられないし、もう害はしないと女は続けた。"
      },
      {
        "scene": "s04",
        "marker": "かず、ず",
        "sentence": "しかしそれさえも確かではなかったため、彼は木こりを呼んだが、老人が返事をしなかった事に驚かずにはいられなかった。"
      },
      {
        "scene": "s06",
        "marker": "べき",
        "sentence": "彼は養うべき母が一人居るが、若いため嫁の問題は考えに上った事はないと答えた。"
      },
      {
        "scene": "s06",
        "marker": "ず",
        "sentence": "打ち明け話の後、2人は長い間何も言わず歩いたが、気があれば眼も口ほどに物を言う通りであった。"
      },
      {
        "scene": "s06",
        "marker": "かず、ず",
        "sentence": "自然の成行きとしてお雪は江戸へは遂に行かず、お嫁としてその家に留まった。"
      },
      {
        "scene": "s08",
        "marker": "ず",
        "sentence": "さらに、木こりの茂作という老人が物も言わず死んでしまった事についても、彼は彼女へ告げた。"
      },
      {
        "scene": "s09",
        "marker": "らず、ず",
        "sentence": "それが夢だったのか雪女だったのか、今もわからずに居る。"
      }
    ],
    "names": [
      "武蔵",
      "茂作",
      "巳之吉",
      "みの"
    ],
    "scenes": 9
  },
  {
    "tale": "rokurokubi",
    "level": "N1",
    "coverage": 0.8631602947652544,
    "kanjiCoverage": 1,
    "kanjiDensity": 0.30481927710843376,
    "meanLength": 38.30769230769231,
    "maxLength": 70,
    "missingRuby": 0,
    "hits": [
      {
        "scene": "s02",
        "marker": "ず",
        "sentence": "僧衣の下には、昔は危険をものともせず今はまた難苦を顧みない、囘龍の武士の魂がいつでも生きていたのである。"
      },
      {
        "scene": "s02",
        "marker": "せず、ず",
        "sentence": "季節にとんじゃくせず、他のそうりょがあえて行こうとしない場所へ出かけた。"
      },
      {
        "scene": "s03",
        "marker": "れぬ、ぬ",
        "sentence": "「私はただの旅の僧であるから、ばけものなど少しも恐れぬ。"
      },
      {
        "scene": "s03",
        "marker": "ぬ",
        "sentence": "私は大空の下で眠る事に慣れており、己の命に不安を抱かぬよう修行を積んできた」「このような場所でやすまれるおぼう様は、全く大胆な方に相違ない。"
      },
      {
        "scene": "s03",
        "marker": "ぬ",
        "sentence": "ここは評判が極めて悪く、賢い者は危うい所に近寄らぬと言う通り、非常に危険だ。"
      },
      {
        "scene": "s04",
        "marker": "申し",
        "sentence": "男の親切な調子が気に入り、囘龍はそのけんそな申し出を受けることにした。"
      },
      {
        "scene": "s06",
        "marker": "けり",
