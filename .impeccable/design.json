  "narrative": {
    "northStar": "A patient rehearsal on warm paper",
    "overview": "Warm paper, ink, and quiet moss surfaces give a learner room to think. Newsreader lends English headings a conversational tone; DM Sans keeps controls and Japanese replies clear. The interface uses flat surfaces and restrained action color.",
    "keyCharacteristics": [
      "Warm paper with moss context surfaces.",
      "Conversational serif headings and readable Japanese.",
      "Flat depth, modest corners, visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use vermilion for actions and meaningful states; use moss for context and help.",
        "section": "colors"
      },
      {
        "name": "The Reply Rule",
        "body": "Keep Japanese replies readable and allow long text to wrap without clipping.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate regions through tone and borders rather than adding elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve warm paper and moss context surfaces.",
      "Do pair Newsreader English headings with sans-serif Japanese replies.",
      "Do keep focus visible and honor reduced motion."
    ],
    "donts": [
      "Don't add shadows to the flat surface system.",
      "Don't use the serif display face for the Japanese reply.",
      "Don't replace SVG controls with glyph icons."
    ]
  },
