# Server only. Never put secrets in VITE_* variables.
DAILY_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# A current open-weight Groq model. Swap after Japanese quality testing.
LLM_MODEL=openai/gpt-oss-20b
# The public browser origin. Set to your Render URL for deployment.
APP_ORIGIN=http://127.0.0.1:5173
# Optional shared access code for live practice. Demo remains public.
LIVE_ACCESS_CODE=
MAX_CONCURRENT_CALLS=2
MAX_CALL_SECONDS=300
