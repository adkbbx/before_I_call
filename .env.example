# Server only. Never put secrets in VITE_* variables.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional for the separate slow-replay endpoint. Select a Japanese voice.
ELEVENLABS_VOICE_ID=
# Exact public app origin, without a trailing slash. Omit for same-origin localhost.
APP_ORIGIN=
# Optional shared access code for issuing live session tokens.
LIVE_ACCESS_CODE=
MAX_CONCURRENT_CALLS=2
MAX_CALL_SECONDS=120
ANALYTICS_ADMIN_KEY=
# Local default; Render uses its persistent /var/data disk.
ANALYTICS_DB_PATH=work/analytics.sqlite3

# Native English voice, optional; Sarah is the default.
ELEVENLABS_ENGLISH_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional voices used only when regenerating prerecorded demo replies.
ELEVENLABS_JAPANESE_REPLY_VOICE_ID=iTqcz0mjbxzCZAfsqojU
ELEVENLABS_ENGLISH_REPLY_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# Cost controls: UTC daily reset, full call duration reserved at admission.
MAX_CALLS_PER_VISITOR_DAY=3
MAX_DAILY_CALL_SECONDS=12000
MAX_HELP_REQUESTS_PER_CALL=6
MAX_SPEECH_REQUESTS_PER_CALL=6

# Optional text-only call preparation
GRADIENT_MODEL_ACCESS_KEY=
GRADIENT_MODEL=gemma-4-31B-it
MAX_PREPARATIONS_PER_VISITOR_DAY=5
MAX_PREPARATIONS_PER_DAY=100

MAX_VOCABULARY_PER_VISITOR_DAY=3
MAX_VOCABULARY_PER_DAY=100

# Agent tracing: the ElevenLabs agent's Custom LLM points at /llm/v1 with LLM_PROXY_KEY as its API key.
LLM_PROXY_KEY=
# Usually left empty locally. Traces are tagged production only on Render, development elsewhere.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
